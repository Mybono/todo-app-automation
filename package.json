    "@wdio/appium-service": "^8.40.0",
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "@wdio/types": "^8.41.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.1.1",
    "appium-uiautomator2-driver": "^6.1.1",
    "chai": "^4.3.8",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pr-checkmate": "^1.0.24",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
