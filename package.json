{
  "name": "todo-app-automation",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "test": "npm run build && wdio run wdio.conf.ts",
    "report": "allure generate reports/allure-results --clean && allure open",
    "test:unit": "jest --coverage",
