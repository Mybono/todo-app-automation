{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "webdriverio", "@wdio/globals/types", "mocha", "jest"]
  },
  "include": ["src/**/*.ts", "wdio.conf.ts", "jest.config.js"],
  "exclude": ["node_modules", "dist"]
}
